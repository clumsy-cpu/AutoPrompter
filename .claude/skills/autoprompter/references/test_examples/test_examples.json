      "example_id": "75d9d5cc",
      "test_name": "test_success_parses_event_array_and_object",
      "category": "workflow",
      "code": "client = make_client()\nevents = [{'type': 'system'}, {'type': 'assistant'}, RESULT]\nrun.return_value = proc(json.dumps(events))\nresp = client.query('hi', system_message='be brief')\nassert (resp.success, resp.content, resp.model) == (True, 'OK', 'claude-haiku-4-5-20251001')\nassert resp.usage == {'prompt_tokens': 602, 'completion_tokens': 4, 'total_tokens': 606}\ncmd = run.call_args.args[0]\nassert run.call_args.kwargs['input'] == 'hi'\nassert cmd[cmd.index('--system-prompt') + 1] == 'be brief'\nassert cmd[cmd.index('--model') + 1] == 'haiku'\nassert '--safe-mode' in cmd and cmd[cmd.index('--tools') + 1] == ''\nrun.return_value = proc(json.dumps(RESULT))\nassert client.query('hi').content == 'OK'\nassert run.call_args.args[0][run.call_args.args[0].index('--system-prompt') + 1] == 'You are a helpful assistant.'",
      "language": "Python",
      "description": "Workflow: test success parses event array and object",
      "expected_behavior": "assert run.call_args.args[0][run.call_args.args[0].index('--system-prompt') + 1] == 'You are a helpful assistant.'",
      "file_path": "~/AutoPrompter/tests/test_claude_cli_client.py",
      "line_start": 33,
      "line_end": 48,
      "complexity_score": 1.0,
      "confidence": 0.9,
      "setup_code": "# Fixtures: run",
